# Copie para backend/.env e preencha. O .env está no .gitignore: nunca faça commit dele.

# Gere uma chave com:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=troque-esta-chave
# 1 só em desenvolvimento. Em produção, deixe 0.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (banco único do sistema). O usuário precisa de CREATEDB para rodar os testes.
POSTGRES_DB=sggd
POSTGRES_USER=sggd
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
